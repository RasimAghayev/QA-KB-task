# QA-KB-task — environment placeholders (Phase 5).
# Copy to .env and fill in only if you need to override a value locally.
# .env is gitignored; this file is the only thing committed, and it contains
# placeholders only — never real secrets.

# Base URL the Cypress suite drives. The repo's own cypress.config.js hard-codes
# https://www.kapitalbank.az/en; override here only if you point the suite at a
# local/staging mirror.
CYPRESS_BASE_URL=https://www.kapitalbank.az/en

# Cypress browser to use inside the test stage (electron = fastest, no extra deps).
CYPRESS_BROWSER=electron

# Headless video / screenshot capture. Disabled by default in Docker because the
# suite is read-only and the artifacts are gitignored.
VIDEO=false
SCREENSHOT=false

# Cypress cloud recording key. Leave blank — recording is not enabled for this
# repo and any value here would be a secret that must never be committed.
CYPRESS_RECORD_KEY=

# Optional per-run overrides.
# CYPRESS_PROJECT_ID=
# CYPRESS_RECORD_TAGS=

# Reserved port block for this repo (projects/info/state/ports.md): 20210-20219.
# No port is mapped — this repo exposes nothing. Kept here for reference.
# APP_PORT=20210